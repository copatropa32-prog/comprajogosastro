---
import '../styles/global.css';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
  canonical?: string;
}

const {    
  titulo = "CompraJogos - Notebooks, PC (Grátis e Pagos), PS4, PS5, Xbox e Nintendo",  
  descricao = "Explore centenas de jogos de PC grátis e pagos, ofertas para PS4, PS5, Xbox, Nintendo, além de notebooks de alta performance.",
  imagem = "https://www.comprajogos.com.br/logo-comprajogos.png",
  canonical = Astro.url.href
} = Astro.props;

const imagemAbsoluta = imagem.startsWith('http') ? imagem : `https://www.comprajogos.com.br${imagem}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="impact-site-verification" value="e47d836d-e695-47d6-b4f1-fa6895dd618b" />
    
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    
    <!-- Open Graph / Redes Sociais / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:secure_url" content={imagemAbsoluta} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="CompraJogos" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemAbsoluta} />

    <!-- Favicon e Logotipo Oficial da Marca -->
    <link rel="icon" type="image/png" href="/logo-comprajogos.png" />
    <link rel="apple-touch-icon" href="/logo-comprajogos.png" />

    <!-- Schema de Organização e WebSite com SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.comprajogos.com.br/#organization",
          "name": "CompraJogos",
          "url": "https://www.comprajogos.com.br",
          "logo": {
            "@type": "ImageObject",
            "@id": "https://www.comprajogos.com.br/#logo",
            "url": "https://www.comprajogos.com.br/logo-comprajogos.png",
            "contentUrl": "https://www.comprajogos.com.br/logo-comprajogos.png",
            "caption": "CompraJogos"
          },
          "sameAs": [
            "https://www.youtube.com/@comprajogosgratis",
            "https://www.instagram.com/comprajogos.com.br/",
            "https://www.tiktok.com/@comprajogosaqui",
            "https://www.facebook.com/profile.php?id=61593639763404"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.comprajogos.com.br/#website",
          "url": "https://www.comprajogos.com.br",
          "name": "CompraJogos",
          "publisher": {
            "@id": "https://www.comprajogos.com.br/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://www.comprajogos.com.br/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
      
    <!-- Google AdSense Script -->
    <script defer src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9710931146430417" crossorigin="anonymous"></script>

    <!-- Trackonomics / Impact Editor Tag -->
    <script type="text/javascript">(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7635219-dac0-4d8a-8ef0-094adcd3d6ec1.js','script','impactStat',document,window);impactStat('trackImpression');</script>

    <!-- Google Identity Services (GIS) SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <!-- SLOT PARA RECEBER SCHEMAS E TAGS EXTRAS -->
    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950">
      
    <!-- Cabeçalho / Navbar -->
    <header class="border-b border-slate-900 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-4">
        
        <a href="/" class="flex items-center gap-3 group shrink-0">
          <img src="/logo-comprajogos.png" alt="CompraJogos" width="40" height="40" class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
          <div class="flex flex-col">
            <span class="text-xs sm:text-sm font-black tracking-wider text-white uppercase group-hover:text-emerald-400 transition-colors">
              COMPRA<span class="text-emerald-400">JOGOS</span>
            </span>
            <span class="text-[10px] font-bold text-orange-400 flex items-center gap-1 tracking-wide mt-0.5">
              Afiliados on fire 🔥
            </span>
          </div>
        </a>

        <div class="flex items-center gap-2 sm:gap-3 w-full max-w-md justify-end">
          <div class="relative w-full hidden sm:block">
            <input 
              type="text" 
              id="search-input" 
              placeholder="Pesquisar jogos, notebooks, PS5, Xbox..." 
              class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
              oninput="filtrarPorTexto(this.value)"
            />
          </div>

          <a href="/blog" class="flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500/50 text-slate-300 hover:text-white text-xs font-bold px-3.5 py-2 rounded-xl transition shrink-0">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
            <span>Blog</span>
          </a>

          <button id="btn-entrar" onclick="abrirModalLogin()" class="flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500/50 text-slate-300 hover:text-white text-xs font-bold px-3.5 py-2 rounded-xl transition shrink-0 cursor-pointer">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <span>Entrar</span>
          </button>
        </div>

      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <!-- Rodapé -->
    <footer class="border-t border-slate-900 bg-slate-950 pt-12 pb-8 mt-16">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-slate-900">
          
          <div class="flex flex-col gap-3">
            <img src="/logo-comprajogos.png" alt="CompraJogos" width="120" height="32" class="h-8 w-auto object-contain self-start mb-1" />
            <p class="text-xs text-slate-400 leading-relaxed">
              O seu portal definitivo para curadoria de keys de PC grátis e pagos, notebooks de alta performance, além de ofertas para PlayStation e Xbox.
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Acompanhe o Canal</span>
            <div class="flex flex-wrap gap-2.5">
              <a href="https://www.youtube.com/@comprajogosgratis" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-red-950/40 border border-slate-800 hover:border-red-500/50 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition">YouTube</a>
              <a href="https://www.instagram.com/comprajogos.com.br/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-pink-950/40 border border-slate-800 hover:border-pink-500/50 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition">Instagram</a>
              <a href="https://www.tiktok.com/@comprajogosaqui" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-600 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition">TikTok</a>
              <a href="https://www.facebook.com/profile.php?id=61593639763404" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-blue-950/40 border border-slate-800 hover:border-blue-500/50 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition">Facebook</a>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Navegação</span>
            <div class="flex flex-col gap-1.5 text-xs text-slate-400">
              <a href="/" class="hover:text-emerald-400 transition">Página Inicial</a>
              <a href="/blog" class="hover:text-emerald-400 transition">Blog & Guias</a>
              <a href="mailto:contato@comprajogos.com.br" class="hover:text-emerald-400 transition">Contato Comercial</a>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Institucional</span>
            <div class="flex flex-col gap-1.5 text-xs text-slate-400">
              <button onclick="abrirModalInstitucional('sobre')" class="text-left hover:text-emerald-400 transition cursor-pointer">Sobre o CompraJogos</button>
              <button onclick="abrirModalInstitucional('termos')" class="text-left hover:text-emerald-400 transition cursor-pointer">Termos de Uso</button>
              <button onclick="abrirModalInstitucional('privacidade')" class="text-left hover:text-emerald-400 transition cursor-pointer">Política de Privacidade</button>
            </div>
          </div>

        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 text-xs text-slate-500">
          <p>&copy; 2026 CompraJogos.com.br. Todos os direitos reservados.</p>
          <p class="text-[11px] text-slate-600">Desenvolvido com foco em games e notebooks de alta performance</p>
        </div>
      </div>
    </footer>

    <!-- Modais -->
    <div id="modal-institucional" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm hidden p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-6 sm:p-8 relative shadow-2xl max-h-[90vh] overflow-y-auto">
        <button onclick="fecharModalInstitucional()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition cursor-pointer">✕</button>
        <div id="conteudo-modal-institucional" class="text-slate-300 text-sm leading-relaxed space-y-4 text-left"></div>
      </div>
    </div>

    <div id="modal-login" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm hidden p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 relative shadow-2xl flex flex-col gap-5 text-slate-300">
        <button onclick="fecharModalLogin()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition cursor-pointer">✕</button>
        <div class="text-center pt-2">
          <h3 class="text-xl font-bold text-white">Acesse sua Conta</h3>
          <p class="text-xs text-slate-400 mt-1">Entre para salvar favoritos e acompanhar ofertas</p>
        </div>
        <div id="buttonDiv" class="flex justify-center w-full py-2"></div>
      </div>
    </div>

    <script is:inline>
      let googleButtonRendered = false;
      function handleCredentialResponse(response) {
        const responsePayload = JSON.parse(atob(response.credential.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
        const userData = { name: responsePayload.name, email: responsePayload.email, picture: responsePayload.picture };
        localStorage.setItem('compra_jogos_user', JSON.stringify(userData));
        atualizarInterfaceUsuario(userData);
        fecharModalLogin();
      }
      function atualizarInterfaceUsuario(user) {
        const btnEntrar = document.getElementById('btn-entrar');
        if (btnEntrar && user) {
          btnEntrar.innerHTML = `<div class="flex items-center gap-2"><img src="${user.picture}" alt="${user.name}" width="24" height="24" class="w-6 h-6 rounded-full object-cover" /><span>${user.name.split(' ')[0]}</span></div>`;
          btnEntrar.onclick = () => { if (confirm(`Deseja sair da conta de ${user.name}?`)) { localStorage.removeItem('compra_jogos_user'); window.location.reload(); } };
        }
      }
      function abrirModalLogin() {
        if (localStorage.getItem('compra_jogos_user')) return;
        document.getElementById('modal-login').classList.remove('hidden');
        if (!googleButtonRendered && window.google?.accounts) {
          try {
            google.accounts.id.initialize({ client_id: "75702393897-88uv9hvhqg0gi12muiqmv23n0vqk75m3.apps.googleusercontent.com", callback: handleCredentialResponse });
            google.accounts.id.renderButton(document.getElementById("buttonDiv"), { theme: "filled_black", size: "large", width: "100%", locale: "pt-BR" });
            googleButtonRendered = true;
          } catch (e) {}
        }
      }
      function fecharModalLogin() { document.getElementById('modal-login').classList.add('hidden'); }
      
      const dadosInstitucionais = {
        sobre: { titulo: "Sobre o CompraJogos", texto: "O CompraJogos é o seu portal definitivo para encontrar chaves de jogos de PC grátis e pagos, notebooks gamers e ofertas para PlayStation e Xbox." },
        termos: { titulo: "Termos de Uso", texto: "Ao utilizar o CompraJogos, você concorda com os termos e condições de uso do portal." },
        privacidade: { titulo: "Política de Privacidade", texto: "Utilizamos armazenamento local (localStorage) apenas para manter sua sessão de login via Google ativa." }
      };
      function abrirModalInstitucional(tipo) {
        const info = dadosInstitucionais[tipo];
        if (info) {
          document.getElementById('conteudo-modal-institucional').innerHTML = `<h3 class="text-xl font-bold text-white mb-2">${info.titulo}</h3><p>${info.texto}</p>`;
          document.getElementById('modal-institucional').classList.remove('hidden');
        }
      }
      function fecharModalInstitucional() { document.getElementById('modal-institucional').classList.add('hidden'); }
      document.addEventListener('DOMContentLoaded', () => {
        const savedUser = localStorage.getItem('compra_jogos_user');
        if (savedUser) atualizarInterfaceUsuario(JSON.parse(savedUser));
      });
    </script>
  </body>
</html>
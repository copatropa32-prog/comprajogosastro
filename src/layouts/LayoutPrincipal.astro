---
interface Props {
  titulo?: string;
  descricao?: string;
}

const { 
  titulo = "CompraJogos - PC (Grátis e Pagos), PS4 e PS5", 
  descricao = "Explore centenas de jogos de PC grátis e pagos, além de ofertas imperdíveis para PS4 e PS5." 
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="impact-site-verification" value="e47d836d-e695-47d6-b4f1-fa6895dd618b" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    
    <!-- Favicon e Logotipo Oficial da Marca -->
    <link rel="icon" type="image/png" href="/logo-comprajogos.png" />
    <link rel="apple-touch-icon" href="/logo-comprajogos.png" />

    <!-- Schema de Organização para o Google reconhecer a marca e o logotipo -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "CompraJogos",
        "url": "https://www.comprajogos.com.br",
        "logo": "https://www.comprajogos.com.br/logo-comprajogos.png"
      }
    </script>
      
    <!-- Google AdSense Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9710931146430417" crossorigin="anonymous"></script>

    <!-- Trackonomics / Impact Editor Tag -->
    <script type="text/javascript">(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7635219-dac0-4d8a-8ef0-094adcd3d6ec1.js','script','impactStat',document,window);impactStat('trackImpression');</script>

    <!-- SLOT ADICIONADO PARA RECEBER SCHEMAS E TAGS EXTRAS -->
    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950">
      
    <!-- Cabeçalho / Navbar -->
    <header class="border-b border-slate-900 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between">
          
        <!-- Logo com Imagem Oficial e Nome ao Lado -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo-comprajogos.png" alt="CompraJogos" class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
          <div class="flex flex-col">
            <span class="text-xs sm:text-sm font-black tracking-wider text-white uppercase group-hover:text-emerald-400 transition-colors">
              COMPRA<span class="text-emerald-400">JOGOS</span>
            </span>
            <span class="text-[10px] text-slate-400 font-medium tracking-wide">
              PC grátis e pagos, PS4 e PS5
            </span>
          </div>
        </a>

        <!-- Barra de Pesquisa Rápida Atualizada para PS4 e PS5 -->
        <div class="relative max-w-xs w-full hidden sm:block">
          <input 
            type="text" 
            id="search-input" 
            placeholder="Pesquisar jogos, PS4, PS5..." 
            class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
            oninput="filtrarPorTexto(this.value)"
          />
        </div>

      </div>
    </header>

    <!-- Conteúdo Principal -->
    <div class="flex-1">
      <slot />
    </div>

    <!-- Rodapé Moderno com Redes Sociais e Cards Destaques -->
    <footer class="border-t border-slate-900 bg-slate-950 pt-12 pb-8 mt-16">
      <div class="container mx-auto px-4">
        
        <!-- Bloco Principal do Rodapé -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-slate-900">
          
          <!-- Coluna 1: Sobre com Logotipo -->
          <div class="flex flex-col gap-3">
            <img src="/logo-comprajogos.png" alt="CompraJogos" class="h-8 w-auto object-contain self-start mb-1" />
            <p class="text-xs text-slate-400 leading-relaxed">
              O seu portal definitivo para curadoria de keys de PC grátis e pagos, além de ofertas imperdíveis para PS4 e PS5.
            </p>
          </div>

          <!-- Coluna 2: Redes Sociais em Destaque -->
          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Acompanhe o Canal</span>
            <div class="flex flex-wrap gap-2.5">
              <!-- Botão YouTube -->
              <a href="https://www.youtube.com/@comprajogosgratis" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-red-950/40 border border-slate-800 hover:border-red-500/50 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition-all duration-300 shadow-sm">
                <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                YouTube
              </a>

              <!-- Botão Instagram -->
              <a href="https://www.instagram.com/comprajogos.com.br/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-pink-950/40 border border-slate-800 hover:border-pink-500/50 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition-all duration-300 shadow-sm">
                <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                Instagram
              </a>

              <!-- Botão TikTok -->
              <a href="https://www.tiktok.com/@comprajogosaqui" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-600 text-slate-300 hover:text-white text-xs font-semibold px-3.5 py-2 rounded-xl transition-all duration-300 shadow-sm">
                <svg class="w-4 h-4 text-cyan-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                TikTok
              </a>
            </div>
          </div>

          <!-- Coluna 3: Navegação -->
          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Navegação</span>
            <div class="flex flex-col gap-1.5 text-xs text-slate-400">
              <a href="/" class="hover:text-emerald-400 transition">Página Inicial</a>
              <a href="mailto:contato@comprajogos.com.br" class="hover:text-emerald-400 transition">Contato Comercial</a>
            </div>
          </div>

          <!-- Coluna 4: Institucional (Exigido pelo Google AdSense) -->
          <div class="flex flex-col gap-3">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Institucional</span>
            <div class="flex flex-col gap-1.5 text-xs text-slate-400">
              <button onclick="abrirModalInstitucional('sobre')" class="text-left hover:text-emerald-400 transition cursor-pointer">Sobre o CompraJogos</button>
              <button onclick="abrirModalInstitucional('termos')" class="text-left hover:text-emerald-400 transition cursor-pointer">Termos de Uso</button>
              <button onclick="abrirModalInstitucional('privacidade')" class="text-left hover:text-emerald-400 transition cursor-pointer">Política de Privacidade</button>
            </div>
          </div>

        </div>

        <!-- Copyright -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 text-xs text-slate-500">
          <p>&copy; 2026 CompraJogos.com.br. Todos os direitos reservados.</p>
          <p class="text-[11px] text-slate-600">Desenvolvido com foco em jogos de PC grátis e pagos, PS4 e PS5</p>
        </div>

      </div>
    </footer>

    <!-- Modal Institucional Universal (Sobre, Termos, Privacidade) -->
    <div id="modal-institucional" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm hidden p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-6 sm:p-8 relative shadow-2xl max-h-[90vh] overflow-y-auto">
        <button onclick="fecharModalInstitucional()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        <div id="conteudo-modal-institucional" class="text-slate-300 text-sm leading-relaxed space-y-4 text-left">
          <!-- Conteúdo injetado via JS -->
        </div>
      </div>
    </div>

    <script>
      // Textos completos exigidos pelo Google AdSense
      const textosInstitucionais = {
        sobre: `
          <h2 class="text-xl font-bold text-white mb-2">Sobre o CompraJogos</h2>
          <p>O <strong>CompraJogos</strong> nasceu da paixão pelo universo dos games e da missão de simplificar a busca por promoções, descontos e chaves de ativação digitais. Nosso portal é dedicado a ajudar jogadores de PC, PlayStation (PS4 e PS5) e outras plataformas a economizarem tempo e dinheiro, reunindo em um único lugar as melhores oportunidades do mercado.</p>
          <p>Monitoramos constantemente plataformas oficiais e lojas parceiras autorizadas para trazer preços atualizados, alertas de jogos gratuitos (free-to-play) e ofertas imperdíveis. Nosso objetivo é ser o seu ponto de partida confiável antes de fechar qualquer compra gamer.</p>
          <p>Para manter este projeto no ar e totalmente gratuito para a comunidade, o CompraJogos participa de programas de marketing de afiliados. Quando você clica em nossos links e realiza uma compra em uma loja parceira, podemos receber uma pequena comissão, <strong>sem nenhum custo adicional para você</strong>.</p>
          <p class="text-xs text-slate-400 pt-2">Dúvidas ou sugestões? Entre em contato: <span class="text-indigo-400 font-medium">contato@comprajogos.com.br</span></p>
        `,
        termos: `
          <h2 class="text-xl font-bold text-white mb-2">Termos de Uso</h2>
          <p>Bem-vindo ao <strong>CompraJogos</strong> (comprajogos.com.br). Ao acessar e utilizar nosso site, você concorda expressamente com os presentes Termos de Uso.</p>
          <p><strong>1. Natureza do Portal:</strong> O CompraJogos é um site informativo de curadoria de ofertas, descontos e chaves de jogos digitais para PC, PS4 e PS5. Não realizamos a venda direta de produtos em nosso domínio; direcionamos os usuários para lojas parceiras oficiais e plataformas autorizadas.</p>
          <p><strong>2. Preços e Disponibilidade:</strong> Os preços, descontos, estoques e condições de pagamento exibidos são definidos exclusivamente pelas lojas parceiras e podem sofrer alterações a qualquer momento. Recomendamos sempre verificar o valor final no site da loja de destino antes de concluir a transação.</p>
          <p><strong>3. Propriedade Intelectual:</strong> Todo o layout, identidade visual, logotipos e organização do conteúdo do CompraJogos são protegidos por leis de propriedade intelectual. É proibida a reprodução não autorizada do conteúdo para fins comerciais sem consentimento prévio.</p>
        `,
        privacidade: `
          <h2 class="text-xl font-bold text-white mb-2">Política de Privacidade</h2>
          <p>A sua privacidade é de suma importância para o <strong>CompraJogos</strong>. Esta Política de Privacidade explica de forma transparente como tratamos informações em nosso site.</p>
          <p><strong>1. Coleta de Dados e Cookies:</strong> Utilizamos cookies e tecnologias semelhantes para otimizar sua experiência de navegação, analisar o tráfego do site e aprimorar nossos serviços de curadoria.</p>
          <p><strong>2. Google AdSense e Anúncios:</strong> Exibimos anúncios fornecidos pelo Google AdSense. O Google utilizes cookies para veicular anúncios com base nas visitas anteriores dos usuários ao nosso site e a outros endereços na internet. Os usuários podem optar por desativar a publicidade personalizada acessando as Configurações de anúncios do Google.</p>
          <p><strong>3. Links de Afiliados:</strong> Nosso site contém links de rastreamento para lojas parceiras. Ao clicar nesses links, um cookie é armazenado em seu navegador pelo parceiro para fins de atribuição de comissão de afiliado, sem comprometer seus dados pessoais ou de pagamento.</p>
        `
      };

      window.abrirModalInstitucional = function(tipo) {
        const modal = document.getElementById('modal-institucional');
        const conteudo = document.getElementById('conteudo-modal-institucional');
        if (modal && conteudo && textosInstitucionais[tipo]) {
          conteudo.innerHTML = textosInstitucionais[tipo];
          modal.classList.remove('hidden');
        }
      };

      window.fecharModalInstitucional = function() {
        const modal = document.getElementById('modal-institucional');
        if (modal) {
          modal.classList.add('hidden');
        }
      };

      // Fechar modal ao clicar fora da caixa de conteúdo
      document.getElementById('modal-institucional')?.addEventListener('click', (e) => {
        if (e.target.id === 'modal-institucional') {
          fecharModalInstitucional();
        }
      });
    </script>

    <script>
      // Função global de busca rápida na navbar
      window.filtrarPorTexto = function(termo) {
        if (typeof catalogoGlobal === 'undefined') return;
        const container = document.getElementById('catalog');
        if (!container) return;

        const termoLower = termo.toLowerCase().trim();
        const filtrados = catalogoGlobal.filter(jogo => 
          jogo.title.toLowerCase().includes(termoLower) || 
          jogo.genre.toLowerCase().includes(termoLower)
        );

        if (filtrados.length === 0) {
          container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-12 rounded-2xl text-center text-slate-400">Nenhum jogo encontrado para "${termo}".</div>`;
          return;
        }

        container.innerHTML = filtrados.map(item => `
          <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:border-slate-700 hover:shadow-2xl hover:-translate-y-1">
            <div class="relative bg-slate-950 h-44 overflow-hidden flex items-center justify-center">
              <img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
              <span class="absolute top-3 left-3 bg-slate-900/90 text-slate-300 text-[10px] font-bold px-2.5 py-1 rounded-md border border-slate-800 uppercase tracking-wider">${item.genre}</span>
              ${item.savings > 0 && item.type === 'paid' ? `<span class="absolute top-3 right-3 bg-emerald-500 text-slate-950 font-black text-xs px-2 py-1 rounded-md shadow">-${item.savings}%</span>` : ''}
              ${item.type === 'free' ? `<span class="absolute top-3 right-3 bg-indigo-600 text-white font-bold text-xs px-2 py-1 rounded-md shadow">Grátis</span>` : ''}
            </div>
            <div class="p-5 flex flex-col flex-1 justify-between gap-4">
              <h4 class="font-bold text-white text-sm line-clamp-2 leading-snug">${item.title}</h4>
              <div class="flex justify-between items-end border-t border-slate-800 pt-4">
                <div>
                  ${item.type === 'paid' ? `
                    <span class="text-xs text-slate-500 line-through block">${item.normalFormatted}</span>
                    <span class="text-lg font-black text-emerald-400">${item.saleFormatted}</span>
                  ` : `
                    <span class="text-xs text-slate-500 block">Plataforma</span>
                    <span class="text-sm font-extrabold text-indigo-400">Free-to-Play</span>
                  `}
                </div>
                <button onclick='abrirModalJogo(${JSON.stringify(item)})' class="font-bold py-2.5 px-4 rounded-xl text-xs transition shadow-lg cursor-pointer ${item.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'}">
                  ${item.type === 'paid' ? 'Ver Oferta' : 'Jogar Grátis'}
                </button>
              </div>
            </div>
          </div>
        `).join('');
      }
    </script>
  </body>
</html>
---
interface Props {
  nome: string;
  preco: string;
  sku: string;
  url: string;
  imagem: string;
  descricao?: string;
  brand?: string;
}

const { nome, preco, sku, url, imagem, descricao, brand } = Astro.props;

// Limpa o preço para o formato numérico exigido pelo Schema.org (ex: "179.78")
const cleanPrice = preco
  .replace('R$', '')
  .trim()
  .replace(/\./g, '')
  .replace(',', '.');

// Garante que a URL da imagem seja absoluta
const siteUrl = Astro.site ? Astro.site.toString() : 'https://comprajogos.com.br/';
const absoluteImage = imagem.startsWith('http') 
  ? imagem 
  : `${siteUrl.replace(/\/$/, '')}${imagem}`;

// Limpa o SKU: remove espaços extras e limita o tamanho para evitar erro de string longa no Google
const cleanSku = sku ? sku.trim().slice(0, 50) : 'JOGO-SKU';

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": nome,
  "image": absoluteImage,
  "description": descricao ? descricao : `Compre ${nome} pelo melhor preço na Compra Jogos.`,
  "sku": cleanSku,
  "brand": {
    "@type": "Brand",
    "name": brand ? brand : "Compra Jogos"
  },
  "offers": {
    "@type": "Offer",
    "url": url,
    "priceCurrency": "BRL",
    "price": cleanPrice,
    "availability": "https://schema.org/InStock"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
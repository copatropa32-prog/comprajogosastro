---
interface Props {
  nome: string;
  preco?: string;
  sku: string;
  url: string;
  imagem: string;
  descricao?: string;
  brand?: string;
}

const { nome, preco = '', sku, url, imagem, descricao, brand } = Astro.props;

// Trata o preço de forma segura: verifica se é grátis, vazio ou texto inválido
const precoLower = (preco || '').toLowerCase();
const isGratuito = precoLower.includes('grátis') || precoLower.includes('gratuito') || preco.trim() === '';

let cleanPrice: number = 0;
if (!isGratuito) {
  // Remove tudo que não for número, vírgula ou ponto, e converte para float
  const numericString = preco
    .replace(/[^\d,.-]/g, '')
    .replace(/\./g, '')
    .replace(',', '.');
  
  cleanPrice = parseFloat(numericString) || 0;
}

// Garante que a URL da imagem seja absoluta
const siteUrl = Astro.site ? Astro.site.toString() : 'https://comprajogos.com.br/';
const absoluteImage = imagem && imagem.startsWith('http') 
  ? imagem 
  : `${siteUrl.replace(/\/$/, '')}${imagem || ''}`;

// Limpa o SKU: remove espaços extras e limita o tamanho para evitar erro de string longa no Google
const cleanSku = sku ? sku.trim().slice(0, 50) : 'JOGO-SKU';

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": nome,
  "image": absoluteImage,
  "description": descricao ? descricao : `Compre ${nome} pelo melhor preço na Compra Jogos.`,
  "sku": cleanSku,
  "brand": {
    "@type": "Brand",
    "name": brand ? brand : "Compra Jogos"
  },
  "offers": {
    "@type": "Offer",
    "url": url,
    "priceCurrency": "BRL",
    "price": cleanPrice,
    "availability": "https://schema.org/InStock"
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
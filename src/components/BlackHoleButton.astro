---
import jogos from '../data/jogos.json';
import notebooks from '../data/notebooks.json';

// Unifica as bases de dados para o sorteio aleatório
const todasOfertas = [...jogos, ...notebooks];
const ofertasJSON = JSON.stringify(todasOfertas);
---

<div class="quantum-container">
  <div class="black-hole-btn" onclick="abrirPortalQuantico()">
    <div class="event-horizon">
      <span class="bh-icon">🌀</span>
      <span class="bh-text">Ativar Buraco Negro</span>
    </div>
  </div>
</div>

<!-- Modal Quântico de Revelação -->
<div id="quantumModal" class="fixed inset-0 bg-black/85 z-50 flex items-center justify-center p-4 backdrop-blur-sm" style="display: none;">
  <div class="bg-slate-900 border-2 border-purple-500 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center text-white relative shadow-[0_0_50px_rgba(168,85,247,0.4)]">
    <button onclick="fecharPortalQuantico()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold cursor-pointer">&times;</button>
    
    <div id="quantumLoading" class="py-8">
      <div class="w-12 h-12 border-4 border-purple-500/30 border-t-purple-500 rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-sm text-purple-300 font-medium">🌀 Calculando probabilidades quânticas no horizonte de eventos...</p>
    </div>

    <div id="quantumResult" class="hidden space-y-4">
      <h3 class="text-lg font-black text-purple-400">✨ Oferta Materializada pelo Buraco Negro!</h3>
      <div id="productCardContent" class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col items-center gap-3"></div>
    </div>
  </div>
</div>

<script define:vars={{ ofertasJSON }}>
  const ofertas = JSON.parse(ofertasJSON);

  window.abrirPortalQuantico = function() {
    if (!ofertas || ofertas.length === 0) return;

    const modal = document.getElementById('quantumModal');
    const loading = document.getElementById('quantumLoading');
    const result = document.getElementById('quantumResult');
    const content = document.getElementById('productCardContent');

    if (!modal) return;

    modal.style.display = 'flex';
    loading.style.display = 'block';
    result.classList.add('hidden');

    setTimeout(() => {
      const sorteado = ofertas[Math.floor(Math.random() * ofertas.length)];
      loading.style.display = 'none';
      result.classList.remove('hidden');

      const preco = sorteado.preco || sorteado.precoAtual || 'Confira no site';
      const imagem = sorteado.image || sorteado.imagem || '/buraconegro.webp';
      const link = sorteado.linkBase || sorteado.linkAfiliado || '#';

      content.innerHTML = `
        <div class="w-full h-36 bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center relative">
          <img src="${imagem}" alt="${sorteado.nome || sorteado.titulo}" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=600&auto=format&fit=crop'" />
        </div>
        <h4 class="font-bold text-sm text-white line-clamp-2 text-left w-full">${sorteado.nome || sorteado.titulo}</h4>
        <div class="flex items-center justify-between w-full pt-2 border-t border-slate-800">
          <span class="text-base font-black text-emerald-400">${preco}</span>
          <a href="${link}" target="_blank" rel="noopener noreferrer" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition shadow-lg cursor-pointer">Ver Oferta 🚀</a>
        </div>
      `;
    }, 1600);
  };

  window.fecharPortalQuantico = function() {
    const modal = document.getElementById('quantumModal');
    if (modal) modal.style.display = 'none';
  };

  window.addEventListener('click', (e) => {
    const modal = document.getElementById('quantumModal');
    if (e.target === modal) modal.style.display = 'none';
  });
</script>

<style>
  .black-hole-btn {
    position: relative; width: 180px; height: 55px; border-radius: 30px;
    background: url('/buraconegro.webp') no-repeat center center; background-size: cover;
    display: flex; align-items: center; justify-content: center; cursor: pointer; overflow: hidden;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.4), inset 0 0 15px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(168, 85, 247, 0.6); transition: transform 0.3s ease, box-shadow 0.3s ease; flex-shrink: 0;
  }
  .black-hole-btn .event-horizon {
    position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 8px;
    color: #fff; font-family: sans-serif; font-size: 13px; font-weight: bold; text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
    background: rgba(0, 0, 0, 0.4); width: 100%; height: 100%; backdrop-filter: blur(1px);
  }
  .black-hole-btn:hover {
    transform: scale(1.06); box-shadow: 0 0 30px rgba(168, 85, 247, 0.8);
  }
</style>
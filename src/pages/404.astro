---
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---

<LayoutPrincipal titulo="Pagina nao encontrada - CompraJogos">
  <div class="container mx-auto px-4 py-24 text-center max-w-lg">
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-10 shadow-2xl">
      <span class="text-emerald-400 font-black text-6xl tracking-widest block mb-4">404</span>
      <h2 class="text-2xl font-bold text-white mb-3">Oops! Pagina nao encontrada</h2>
      <p class="text-slate-400 text-sm mb-8 leading-relaxed">O jogo ou link que voce tentou acessar pode ter expirado ou nao existe mais no catalogo.</p>
      <a href="/" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-6 py-3.5 rounded-xl transition shadow-lg inline-block">
        &larr; Voltar para a Pagina Inicial
      </a>
    </div>
  </div>
</LayoutPrincipal>
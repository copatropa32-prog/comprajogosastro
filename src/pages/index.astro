      const wrapper = document.getElementById('ad-slot-wrapper');
      if (wrapper) {
        wrapper.innerHTML = `
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="ca-pub-9710931146430417"
               data-ad-slot="SEU_ID_DO_SLOT"
               data-ad-format="auto"
               data-full-width-responsive="true"></ins>
        `;
        try {
          (adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      }
      window.removeEventListener('scroll', verificarRolagemParaAds);
    }

    function verificarRolagemParaAds() {
      if (window.scrollY > 80) {
        carregarGoogleAdSense();
      }
    }

    window.addEventListener('scroll', verificarRolagemParaAds, { passive: true });


  <!-- Botão Flutuante Moderno: Voltar ao Topo -->
  <button
    id="scrollToTopBtn"
    aria-label="Voltar ao topo"
    class="fixed bottom-22 right-6 z-40 flex items-center justify-center w-12 h-12 bg-slate-900/90 hover:bg-emerald-500 text-white rounded-full shadow-2xl backdrop-blur-md border border-slate-700 hover:border-emerald-400 opacity-0 invisible transition-all duration-300 transform translate-y-4 hover:scale-110 cursor-pointer"
  >
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      class="w-5 h-5 transition-transform duration-300 hover:-translate-y-0.5" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <style>
    .black-hole-btn {
      position: relative;
      width: 180px;
      height: 55px;
      border-radius: 30px;
      background: url('/buraconegro.webp') no-repeat center center;
      background-size: cover;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      box-shadow: 0 0 20px rgba(255, 120, 50, 0.4), inset 0 0 15px rgba(0, 0, 0, 0.8);
      border: 1px solid rgba(255, 150, 50, 0.4);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      flex-shrink: 0;
    }

    .black-hole-btn .event-horizon {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #fff;
      font-family: sans-serif;
      font-size: 13px;
      font-weight: bold;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
      background: rgba(0, 0, 0, 0.4);
      width: 100%;
      height: 100%;
      backdrop-filter: blur(1px);
    }

    .black-hole-btn:hover {
      transform: scale(1.06);
      box-shadow: 0 0 30px rgba(255, 120, 50, 0.7), 0 0 50px rgba(0, 242, 254, 0.3);
      border-color: rgba(255, 200, 100, 0.8);
    }

    .bh-icon {
      font-size: 15px;
    }
  </style>

  <script>
    const scrollBtn = document.getElementById('scrollToTopBtn');
    if (scrollBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 350) {
          scrollBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
          scrollBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
        } else {
          scrollBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
          scrollBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
        }
      });

      scrollBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  </script>


---
import '../styles/global.css';
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
---

<LayoutPrincipal titulo="Compra Jogos - Keys, Ofertas e Jogos Gratuitos" descricao="Explore centenas de jogos gratuitos (F2P) e descontos imbatíveis em chaves de PC.">
  <main class="container mx-auto px-4 py-8">
    
    <!-- Filtros e Barra de Gêneros -->
    <div class="bg-slate-900/80 backdrop-blur-md p-5 rounded-2xl border border-slate-800 shadow-xl mb-8 flex flex-col gap-4">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filtrar por:</span>
        <button onclick="mudarTipo('all', this)" class="filter-btn active bg-emerald-500 text-slate-950 px-4 py-2 rounded-full text-xs font-bold transition">Todos</button>
        <button onclick="mudarTipo('paid', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition">Jogos Pagos / Keys</button>
        <button onclick="mudarTipo('free', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition">Jogos Gratuitos (F2P)</button>
      </div>
      
      <!-- Barra de Gêneros -->
      <div id="genre-bar" class="flex gap-2 overflow-x-auto pb-2 scrollbar-thin"></div>
    </div>

    <!-- Espaço / Banner do Google AdSense -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-4 mb-8 text-center overflow-hidden flex flex-col items-center justify-center">
      <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-2 font-semibold">Anúncio Publicitário</span>
      <div class="w-full min-h-[90px] flex items-center justify-center">
        <!-- Cole a tag <ins> do seu bloco de anúncio do AdSense aqui quando quiser ativá-lo -->
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-9710931146430417"
             data-ad-slot="SEU_ID_DO_SLOT"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>
             (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    </div>

    <!-- Grade de Jogos -->
    <div id="catalog" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div class="col-span-full bg-slate-900/50 border border-slate-800 p-12 rounded-2xl text-center text-slate-400 flex flex-col items-center justify-center gap-4">
        <div class="w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <span class="text-sm font-medium">Sincronizando 200 jogos das APIs...</span>
      </div>
    </div>

  </main>

  <!-- Rodapé Completo Institucional -->
  <footer class="bg-slate-950 border-t border-slate-900 mt-16 text-slate-400 text-sm">
    <div class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Sobre o CompraJogos -->
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Sobre o CompraJogos</h3>
        <p class="text-xs leading-relaxed text-slate-400">
          O CompraJogos é um portal especializado em curadoria de chaves de PC e jogos gratuitos com os melhores preços do mercado.
        </p>
        <button onclick="abrirModalInstitucional('sobre')" class="text-emerald-400 hover:text-emerald-300 text-xs font-semibold text-left transition w-max cursor-pointer">
          Ler mais sobre nós &rarr;
        </button>
      </div>

      <!-- Políticas e Termos -->
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Políticas e Termos</h3>
        <ul class="flex flex-col gap-2 text-xs">
          <li>
            <button onclick="abrirModalInstitucional('privacidade')" class="hover:text-white transition text-left cursor-pointer">
              Política de Privacidade
            </button>
          </li>
          <li>
            <button onclick="abrirModalInstitucional('termos')" class="hover:text-white transition text-left cursor-pointer">
              Termos de Uso
            </button>
          </li>
        </ul>
      </div>

      <!-- Contato & Afiliados -->
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Contato & Afiliados</h3>
        <p class="text-xs">
          Suporte: <a href="mailto:contato@comprajogos.com.br" class="text-emerald-400 hover:underline">contato@comprajogos.com.br</a>
        </p>
        <p class="text-[11px] text-slate-500 leading-relaxed">
          <strong>Aviso de Isenção:</strong> O CompraJogos participa de programas de afiliados. Podemos receber comissões por compras realizadas através dos links indicados, sem custo adicional para você.
        </p>
      </div>

    </div>

    <div class="border-t border-slate-900/80 py-6 text-center text-xs text-slate-500">
      &copy; 2026 CompraJogos.com.br - Todos os direitos reservados.
    </div>
  </footer>

  <!-- Modal Geral (Institucional e Detalhes do Jogo) -->
  <div id="modal-container" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 relative shadow-2xl flex flex-col gap-4 text-slate-300">
      <button onclick="fecharModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-slate-800 p-1.5 rounded-full transition z-10 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      <div id="modal-content" class="text-sm leading-relaxed flex flex-col gap-3 max-h-[75vh] overflow-y-auto pr-2"></div>
    </div>
  </div>

  <script>
    let catalogoGlobal = [];
    let tipoAtual = 'all';
    let generoAtual = 'all';

    async function carregarTudo() {
      const container = document.getElementById('catalog');
      
      let dolarTaxa = 5.50;
      try {
        const cotacaoRes = await fetch('https://economia.awesomeapi.com.br/json/last/USD-BRL');
        const cotacaoData = await cotacaoRes.json();
        dolarTaxa = parseFloat(cotacaoData.USDBRL.bid) || 5.50;
      } catch (e) {
        console.warn("Usando taxa padrão do dólar.");
      }

      let paidFormatted = [];
      try {
        const resPaid = await fetch('https://www.cheapshark.com/api/1.0/deals?storeID=1&pageSize=100&sortBy=Reviews');
        const paidData = await resPaid.json();
        if (Array.isArray(paidData)) {
          paidFormatted = paidData.map((item, index) => {
            const saleBRL = (parseFloat(item.salePrice || 0) * dolarTaxa).toFixed(2);
            const normalBRL = (parseFloat(item.normalPrice || 0) * dolarTaxa).toFixed(2);
            const dealUrl = `https://www.cheapshark.com/redirect?dealID=${item.dealID}`;
            return {
              id: `paid-${index}`,
              title: item.title || 'Jogo',
              type: 'paid',
              genre: 'PC Key / Oferta',
              image: item.thumb || '',
              saleFormatted: `R$ ${saleBRL.replace('.', ',')}`,
              normalFormatted: `R$ ${normalBRL.replace('.', ',')}`,
              savings: Math.round(item.savings || 0),
              url: dealUrl
            };
          });
        }
      } catch (e) {
        console.error("Erro na API Paid:", e);
      }

      let freeFormatted = [];
      try {
        const resFree = await fetch('https://www.freetogame.com/api/games');
        const freeData = await resFree.json();
        if (Array.isArray(freeData)) {
          freeFormatted = freeData.slice(0, 100).map((item, index) => {
            return {
              id: `free-${index}`,
              title: item.title || 'Jogo Gratuito',
              type: 'free',
              genre: item.genre || 'Free-to-Play',
              image: item.thumbnail || '',
              saleFormatted: 'Gratuito',
              normalFormatted: '',
              savings: 100,
              url: item.game_url || '#'
            };
          });
        }
      } catch (e) {
        console.error("Erro na API Free:", e);
      }

      catalogoGlobal = [...freeFormatted, ...paidFormatted];

      if (catalogoGlobal.length === 0) {
        container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-8 rounded-xl text-center text-red-400">Erro ao carregar os jogos. Verifique sua conexão.</div>`;
        return;
      }

      construirBarraGeneros();
      filtrarEFiltrarJogos();
    }

    function construirBarraGeneros() {
      const bar = document.getElementById('genre-bar');
      bar.innerHTML = '';

      const btnTodos = document.createElement('button');
      btnTodos.className = `px-3.5 py-1.5 rounded-full text-xs font-semibold transition whitespace-nowrap border cursor-pointer ${generoAtual === 'all' ? 'bg-emerald-500 text-slate-950 border-emerald-500 font-bold shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 border-slate-800 hover:bg-slate-800 hover:text-white'}`;
      btnTodos.innerText = 'Todos os Gêneros';
      btnTodos.onclick = () => mudarGenero('all', btnTodos);
      bar.appendChild(btnTodos);

      const itensFiltradosPorTipo = tipoAtual === 'all' 
        ? catalogoGlobal 
        : catalogoGlobal.filter(j => j.type === tipoAtual);

      const generosUnicos = [...new Set(itensFiltradosPorTipo.map(j => j.genre))].sort();

      generosUnicos.forEach(g => {
        const btn = document.createElement('button');
        btn.className = `px-3.5 py-1.5 rounded-full text-xs font-semibold transition whitespace-nowrap border cursor-pointer ${generoAtual === g ? 'bg-emerald-500 text-slate-950 border-emerald-500 font-bold shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 border-slate-800 hover:bg-slate-800 hover:text-white'}`;
        btn.innerText = g;
        btn.onclick = () => mudarGenero(g, btn);
        bar.appendChild(btn);
      });
    }

    window.mudarTipo = function(tipo, el) {
      tipoAtual = tipo;
      generoAtual = 'all'; 
      
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      el.classList.remove('bg-slate-800', 'text-slate-300');
      el.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      
      construirBarraGeneros();
      filtrarEFiltrarJogos();
    }

    function mudarGenero(genero, el) {
      generoAtual = genero;
      construirBarraGeneros();
      filtrarEFiltrarJogos();
    }

    window.filtrarEFiltrarJogos = function() {
      const container = document.getElementById('catalog');

      const filtrados = catalogoGlobal.filter(jogo => {
        const matchTipo = tipoAtual === 'all' || jogo.type === tipoAtual;
        const matchGenero = generoAtual === 'all' || jogo.genre === generoAtual;
        return matchTipo && matchGenero;
      });

      if (filtrados.length === 0) {
        container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-12 rounded-2xl text-center text-slate-400">Nenhum item encontrado com esses filtros.</div>`;
        return;
      }

      container.innerHTML = filtrados.map(item => `
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:border-slate-700 hover:shadow-2xl hover:-translate-y-1">
          <div class="relative bg-slate-950 h-44 overflow-hidden flex items-center justify-center">
            <img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
            <span class="absolute top-3 left-3 bg-slate-900/90 text-slate-300 text-[10px] font-bold px-2.5 py-1 rounded-md border border-slate-800 uppercase tracking-wider">${item.genre}</span>
            ${item.savings > 0 && item.type === 'paid' ? `<span class="absolute top-3 right-3 bg-emerald-500 text-slate-950 font-black text-xs px-2 py-1 rounded-md shadow">-${item.savings}%</span>` : ''}
            ${item.type === 'free' ? `<span class="absolute top-3 right-3 bg-indigo-600 text-white font-bold text-xs px-2 py-1 rounded-md shadow">Grátis</span>` : ''}
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between gap-4">
            <h4 class="font-bold text-white text-sm line-clamp-2 leading-snug">${item.title}</h4>
            <div class="flex justify-between items-end border-t border-slate-800 pt-4">
              <div>
                ${item.type === 'paid' ? `
                  <span class="text-xs text-slate-500 line-through block">${item.normalFormatted}</span>
                  <span class="text-lg font-black text-emerald-400">${item.saleFormatted}</span>
                ` : `
                  <span class="text-xs text-slate-500 block">Plataforma PC</span>
                  <span class="text-sm font-extrabold text-indigo-400">Free-to-Play</span>
                `}
              </div>
              <button onclick='abrirModalJogo(${JSON.stringify(item)})' class="font-bold py-2.5 px-4 rounded-xl text-xs transition shadow-lg cursor-pointer ${item.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'}">
                ${item.type === 'paid' ? 'Ver Oferta' : 'Jogar Grátis'}
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Modal de Detalhes do Jogo
    window.abrirModalJogo = function(jogo) {
      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      
      content.innerHTML = `
        <div class="flex flex-col gap-4">
          <div class="w-full h-48 rounded-xl overflow-hidden bg-slate-950 border border-slate-800">
            <img src="${jogo.image}" alt="${jogo.title}" class="w-full h-full object-cover" />
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">${jogo.genre}</span>
            <h3 class="text-xl font-bold text-white mt-1">${jogo.title}</h3>
          </div>
          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block">Preço na Loja Oficial</span>
              ${jogo.type === 'paid' ? `
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-xs text-slate-500 line-through">${jogo.normalFormatted}</span>
                  <span class="text-xl font-black text-emerald-400">${jogo.saleFormatted}</span>
                </div>
              ` : `
                <span class="text-base font-bold text-indigo-400">100% Gratuito (F2P)</span>
              `}
            </div>
            ${jogo.savings > 0 && jogo.type === 'paid' ? `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-lg text-xs font-bold">Desconto de ${jogo.savings}%</span>` : ''}
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Você está prestes a ser redirecionado para a nossa loja parceira oficial para resgatar a sua chave de ativação com segurança. O CompraJogos garante as melhores ofertas verificadas para PC.
          </p>
          <div class="flex gap-3 pt-2">
            <button onclick="fecharModal()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3 px-4 rounded-xl text-xs transition cursor-pointer">
              Voltar ao Catálogo
            </button>
            <a href="${jogo.url}" target="_blank" rel="noopener noreferrer" onclick="fecharModal()" class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-3 px-4 rounded-xl text-xs text-center transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer">
              Ir para a Loja Oficial &rarr;
            </a>
          </div>
        </div>
      `;
      modal.classList.remove('hidden');
    }

    // Textos institucionais do Rodapé
    const textosModais = {
      sobre: `
        <h3 class="text-lg font-bold text-white">Sobre o CompraJogos</h3>
        <p>O <strong>CompraJogos.com.br</strong> é um portal especializado em curadoria e agregação de ofertas de chaves de jogos para PC (keys) e jogos gratuitos (Free-to-Play).</p>
        <p><strong>Idealizadora:</strong> O projeto foi idealizado por <em>Beatriz Marcondes Cesar</em> com o propósito de conectar jogadores aos melhores preços e promoções do mercado digital de forma ágil, segura e centralizada.</p>
        <p>Nosso objetivo principal é simplificar a busca por entretenimento digital de qualidade, permitindo que a comunidade encontre descontos expressivos e novidades sem complicações.</p>
      `,
      privacidade: `
        <h3 class="text-lg font-bold text-white">Política de Privacidade</h3>
        <p>A sua privacidade é importante para nós. O <strong>CompraJogos.com.br</strong> segue diretrizes rígidas de proteção de dados.</p>
        <p><strong>Uso de Cookies e Anúncios:</strong> Utilizamos serviços de terceiros, como o Google AdSense, para exibir anúncios relevantes aos visitantes. O Google pode usar cookies (como o cookie DART) para exibir anúncios com base em suas visitas a este e a outros sites na internet.</p>
        <p>Você pode desativar o uso do cookie DART visitando a política de privacidade da rede de conteúdo e dos anúncios do Google.</p>
        <p>Não coletamos informações pessoais sensíveis diretamente em nosso banco de dados sem o seu consentimento explícito.</p>
      `,
      termos: `
        <h3 class="text-lg font-bold text-white">Termos de Uso</h3>
        <p>Ao acessar o site <strong>CompraJogos.com.br</strong>, você concorda em cumprir estes termos de serviço, todas as leis e regulamentos aplicáveis.</p>
        <p><strong>Isenção de Responsabilidade sobre Preços e Links:</strong> Os preços, descontos e disponibilidades dos jogos exibidos em nosso catálogo são obtidos em tempo real através de APIs parceiras e podem sofrer alterações por parte das lojas oficiais a qualquer momento. O CompraJogos atua como agregador e redirecionador, não realizando a venda direta dos produtos digitais.</p>
        <p><strong>Afiliados:</strong> O CompraJogos participa de programas de afiliados. Podemos receber comissões por compras realizadas através dos links indicados, sem custo adicional para você.</p>
      `
    };

    window.abrirModalInstitucional = function(tipo) {
      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      if (textosModais[tipo]) {
        content.innerHTML = textosModais[tipo];
        modal.classList.remove('hidden');
      }
    }

    window.fecharModal = function() {
      const modal = document.getElementById('modal-container');
      modal.classList.add('hidden');
    }

    document.getElementById('modal-container').addEventListener('click', (e) => {
      if (e.target.id === 'modal-container') {
        fecharModal();
      }
    });

    carregarTudo();
  </script>
</LayoutPrincipal>

        }
      ];

      let freeFormatted = [];
      try {
        const resFree = await fetch('https://www.freetogame.com/api/games?sort-by=popularity');
        const freeData = await resFree.json();
        if (Array.isArray(freeData)) {
          freeFormatted = freeData.slice(0, 60).map(item => ({
            id: `free-${item.id}`,
            title: item.title,
            type: 'free',

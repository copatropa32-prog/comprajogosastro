    function construirCarrossel2026() {
      const track = document.getElementById('carousel-track');
      if (!track) return;

      let lancamentos = catalogoGlobal.filter(j => j.id.startsWith('bb-'));

      lancamentos.sort((a, b) => {
        if (a.id === 'bb-gta6') return -1;
        if (b.id === 'bb-gta6') return 1;
        return 0;
      });

      if (lancamentos.length === 0) {
        track.innerHTML = `<div class="text-slate-400 text-xs p-4">Nenhum destaque encontrado.</div>`;
        return;
      }

      track.innerHTML = lancamentos.map(item => `
        <div class="min-w-[260px] sm:min-w-[280px] max-w-[280px] bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between shrink-0 snap-start shadow-xl hover:border-slate-700 transition">
          <div class="relative bg-slate-950 h-36 overflow-hidden flex items-center justify-center">
            <img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=600&auto=format&fit=crop'" />
            <span class="absolute top-2 left-2 bg-emerald-500/90 text-slate-950 text-[9px] font-extrabold px-2 py-0.5 rounded uppercase tracking-wider">${item.ano || '2026'}</span>
            ${item.id === 'bb-gta6' ? '<span class="absolute top-2 right-2 bg-indigo-600 text-white font-black text-[10px] px-2 py-0.5 rounded shadow">Mais Esperado</span>' : ''}
            ${item.savings > 0 && item.id !== 'bb-gta6' ? `<span class="absolute top-2 right-2 bg-emerald-500 text-slate-950 font-black text-xs px-2 py-0.5 rounded shadow">-${item.savings}%</span>` : ''}
          </div>
          <div class="p-4 flex flex-col flex-1 justify-between gap-3">
            <h4 class="font-bold text-white text-xs line-clamp-2 leading-snug">${item.title}</h4>
            <div class="flex justify-between items-end border-t border-slate-800/80 pt-3">
              <div>
                ${item.normalFormatted ? `<span class="text-[10px] text-slate-500 line-through block">${item.normalFormatted}</span>` : ''}
                <span class="text-base font-black text-emerald-400">${item.saleFormatted}</span>
              </div>
              <button onclick="abrirModalJogo('${item.id}')" class="font-bold py-2 px-3 rounded-lg text-[11px] transition shadow bg-emerald-500 hover:bg-emerald-400 text-slate-950 cursor-pointer">
                Ver Oferta
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function iniciarCarrosselAutomatico() {
      const track = document.getElementById('carousel-track');
      if (!track) return;

      // Aumentado para 7000ms (7 segundos) para ficar bem mais devagar e suave
      carouselInterval = setInterval(() => {
        const maxScrollLeft = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScrollLeft - 10) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: 300, behavior: 'smooth' });
        }
      }, 7000);

      track.addEventListener('mouseenter', () => {
        clearInterval(carouselInterval);
      });

      track.addEventListener('mouseleave', () => {
        iniciarCarrosselAutomatico();
      });
    }

    window.rolarCarrossel = function(direcao) {
      const track = document.getElementById('carousel-track');
      if (!track) return;
      const scrollAmount = 300;
      track.scrollBy({ left: direcao * scrollAmount, behavior: 'smooth' });
    }

    function construirBarraGeneros() {
      const bar = document.getElementById('genre-bar');
      if (!bar) return;
      bar.innerHTML = '';
      const generosUnicos = ['Todos os Gêneros', ...new Set(catalogoGlobal.map(j => j.genre))].sort();
      generosUnicos.forEach(g => {
        const btn = document.createElement('button');
        btn.className = `px-3.5 py-1.5 rounded-full text-xs font-semibold transition whitespace-nowrap border cursor-pointer ${generoAtual === g ? 'bg-emerald-500 text-slate-950 border-emerald-500 font-bold shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 border-slate-800 hover:bg-slate-800 hover:text-white'}`;
        btn.innerText = g;
        btn.onclick = () => mudarGenero(g);
        bar.appendChild(btn);
      });
    }

    window.mudarFiltro = function(filtro, el) {
      filtroAtual = filtro;
      generoAtual = 'Todos os Gêneros';
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      el.classList.remove('bg-slate-800', 'text-slate-300');
      el.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      construirBarraGeneros();
      filtrarJogos();
    }

    function mudarGenero(genero) {
      generoAtual = genero;
      construirBarraGeneros();
      filtrarJogos();
    }

    window.filtrarJogos = function() {
      const container = document.getElementById('catalog');
      if (!container) return;

      const minVal = parseFloat(document.getElementById('minPrice').value) || 0;
      const maxVal = parseFloat(document.getElementById('maxPrice').value) || Infinity;

      const filtrados = catalogoGlobal.filter(j => {
        let matchFiltro = true;
        if (filtroAtual === 'promocoes') {
          matchFiltro = (j.type === 'paid' || j.type === 'notebook') && j.savings > 0;
        } else if (filtroAtual === 'gratuitos') {
          matchFiltro = j.type === 'free';
        } else if (filtroAtual === 'notebooks') {
          matchFiltro = j.type === 'notebook';
        } else if (filtroAtual === 'pc') {
          matchFiltro = j.platform === 'PC';
        } else if (filtroAtual === 'ps5') {
          matchFiltro = j.platform === 'PS5';
        } else if (filtroAtual === 'xbox') {
          matchFiltro = j.platform === 'Xbox';
        } else if (filtroAtual === 'nintendo') {
          matchFiltro = j.platform === 'Nintendo';
        }

        const matchGenero = generoAtual === 'Todos os Gêneros' || j.genre === generoAtual;
        const precoNumerico = parsePrice(j.saleFormatted);
        const matchPreco = precoNumerico >= minVal && precoNumerico <= maxVal;

        return matchFiltro && matchGenero && matchPreco;
      });

      if (filtrados.length === 0) {
        container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-12 rounded-2xl text-center text-slate-400">Nenhum item encontrado com esses filtros.</div>`;
        return;
      }

      container.innerHTML = filtrados.map(item => `
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-slate-700 transition-all duration-300 shadow-xl">
          <div class="relative bg-slate-950 h-44 overflow-hidden flex items-center justify-center">
            <img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=600&auto=format&fit=crop'" />
            <span class="absolute top-3 left-3 bg-slate-900/90 text-slate-300 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider">${item.genre}</span>
            ${item.savings > 0 && (item.type === 'paid' || item.type === 'notebook') ? `<span class="absolute top-3 right-3 bg-emerald-500 text-slate-950 font-black text-xs px-2 py-1 rounded-md shadow">-${item.savings}%</span>` : ''}
            ${item.type === 'free' ? `<span class="absolute top-3 right-3 bg-indigo-600 text-white font-bold text-xs px-2 py-1 rounded-md shadow">Grátis</span>` : ''}
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between gap-4">
            <h4 class="font-bold text-white text-sm line-clamp-2 leading-snug">${item.title}</h4>
            <div class="flex justify-between items-end border-t border-slate-800 pt-4">
              <div>
                ${item.type === 'paid' || item.type === 'notebook' ? `
                  ${item.normalFormatted ? `<span class="text-xs text-slate-500 line-through block">${item.normalFormatted}</span>` : ''}
                  <span class="text-lg font-black text-emerald-400">${item.saleFormatted}</span>
                ` : `
                  <span class="text-xs text-slate-500 block">Plataforma PC</span>
                  <span class="text-sm font-extrabold text-indigo-400">Free-to-Play</span>
                `}
            </div>
            <button onclick="abrirModalJogo('${item.id}')" class="font-bold py-2.5 px-4 rounded-xl text-xs transition shadow-lg cursor-pointer ${item.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'}">
              ${item.type === 'free' ? 'Jogar Grátis' : item.type === 'notebook' ? 'Ver Notebook' : 'Ver Oferta'}
            </button>
          </div>
        </div>
      </div>
      `).join('');
    }

    window.abrirModalJogo = function(id) {
      const jogo = catalogoGlobal.find(j => j.id === id);
      if (!jogo) return;

      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      
      content.innerHTML = `
        <div class="flex flex-col gap-4">
          <div class="w-full h-48 rounded-xl overflow-hidden bg-slate-950 border border-slate-800">
            <img src="${jogo.image}" alt="${jogo.title}" class="w-full h-full object-cover" />
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">${jogo.genre} (${jogo.ano || '2026'})</span>
            <h3 class="text-xl font-bold text-white mt-1">${jogo.title}</h3>
          </div>
          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block">${jogo.type === 'free' ? 'Tipo de Acesso' : 'Preço na Loja'}</span>
              <span class="text-xl font-black ${jogo.type === 'free' ? 'text-indigo-400' : 'text-emerald-400'} mt-1 block">${jogo.saleFormatted}</span>
            </div>
            ${jogo.savings > 0 && (jogo.type === 'paid' || jogo.type === 'notebook') ? `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-lg text-xs font-bold">-${jogo.savings}% OFF</span>` : ''}
          </div>
          ${jogo.descricao ? `
            <div class="bg-slate-950/40 p-3.5 rounded-xl border border-slate-800 text-xs text-slate-300 leading-relaxed">
              <span class="font-bold text-white block mb-1">Sinopse / Detalhes:</span>
              ${jogo.descricao}
            </div>
          ` : ''}
          <a href="${jogo.url}" target="_blank" rel="noopener noreferrer" onclick="fecharModal()" class="w-full ${jogo.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'} font-bold py-3.5 px-4 rounded-xl text-xs text-center transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
            ${jogo.type === 'free' ? 'Acessar Jogo Grátis' : jogo.type === 'notebook' ? 'Ver Notebook na Loja' : 'Ir para a Loja Oficial'} &rarr;
          </a>
        </div>
      `;
      modal.classList.remove('hidden');
    }

    const textosModais = {
      sobre: `<h3 class="text-lg font-bold text-white">Sobre o CompraJogos</h3><p>Portal especializado em curadoria de ofertas de chaves de PC, consoles e notebooks de alto desempenho.</p>`,
      privacidade: `<h3 class="text-lg font-bold text-white">Política de Privacidade</h3><p>Seus dados estão seguros. Utilizamos cookies para melhor experiência.</p>`,
      termos: `<h3 class="text-lg font-bold text-white">Termos de Uso</h3><p>Ao utilizar nosso site, você concorda com nossos termos de parceria e afiliados.</p>`
    };

    window.abrirModalInstitucional = function(tipo) {
      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      content.innerHTML = textosModais[tipo] || '';
      modal.classList.remove('hidden');
    }

    window.fecharModal = function() {
      const modal = document.getElementById('modal-container');
      modal.classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
        carregarTudo();
    });
  </script>
</LayoutPrincipal>
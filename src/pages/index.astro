---
import '../styles/global.css';
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import jogosLocais from '../data/jogos.json'; 
import notebooksLocais from '../data/notebooks.json';
import ProductSchema from '../components/ProductSchema.astro';
---

<LayoutPrincipal titulo="CompraJogos - Notebooks, PC (Grátis e Pagos), PS4, PS5, Xbox e Nintendo" descricao="Explore centenas de jogos de PC grátis e pagos, ofertas para PS4, PS5, Xbox, Nintendo, além de notebooks de alta performance.">
  <head slot="head">
    <!-- Schema.org gerado no servidor para cada jogo do catálogo -->
    {jogosLocais.map((jogo) => (
      <ProductSchema 
        nome={jogo.nome}
        preco={jogo.preco}
        sku={jogo.nome}
        url={jogo.linkBase}
        imagem={jogo.image}
      />
    ))}
    <!-- Schema.org gerado no servidor para cada notebook -->
    {notebooksLocais.map((nb) => (
      <ProductSchema 
        nome={nb.nome}
        preco={nb.preco}
        sku={nb.nome}
        url={nb.linkBase}
        imagem={nb.image}
      />
    ))}
  </head>

  <main class="container mx-auto px-4 py-8">
    
    <!-- Filtros e Barra de Gêneros -->
    <div class="bg-slate-900/85 backdrop-blur-md p-5 rounded-2xl border border-slate-800 shadow-xl mb-8 flex flex-col gap-4">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filtrar por:</span>
        <button onclick="mudarFiltro('all', this)" class="filter-btn active bg-emerald-500 text-slate-950 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Todos</button>
        <button onclick="mudarFiltro('promocoes', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Promoções</button>
        <button onclick="mudarFiltro('gratuitos', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Jogos Gratuitos</button>
        <button onclick="mudarFiltro('notebooks', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Notebooks</button>
        <button onclick="mudarFiltro('pc', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">PC</button>
        <button onclick="mudarFiltro('ps4', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">PS4</button>
        <button onclick="mudarFiltro('ps5', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">PS5</button>
        <button onclick="mudarFiltro('xbox', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Xbox</button>
        <button onclick="mudarFiltro('nintendo', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Nintendo</button>
      </div>

      <!-- Filtro de Preço -->
      <div class="flex items-center gap-3 flex-wrap pt-4 border-t border-slate-800">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Faixa de Preço (R$):</span>
        <input type="number" id="minPrice" placeholder="Mín" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white w-24 focus:outline-none focus:border-emerald-500">
        <input type="number" id="maxPrice" placeholder="Máx" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white w-24 focus:outline-none focus:border-emerald-500">
        <button onclick="filtrarJogos()" class="bg-slate-800 hover:bg-emerald-600 text-white px-4 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer">Aplicar Preço</button>
      </div>

      <div id="genre-bar" class="flex gap-2 overflow-x-auto pb-2 scrollbar-thin"></div>
    </div>

    <!-- Anúncio Google AdSense -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-4 mb-8 text-center overflow-hidden flex flex-col items-center justify-center">
      <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-2 font-semibold">Anúncio Publicitário</span>
      <div class="w-full min-h-[90px] flex items-center justify-center">
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-9710931146430417"
             data-ad-slot="SEU_ID_DO_SLOT"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script is:inline>
             (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    </div>

    <!-- Grade de Produtos -->
    <div id="catalog" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div class="col-span-full bg-slate-900/50 border border-slate-800 p-12 rounded-2xl text-center text-slate-400 flex flex-col items-center justify-center gap-4">
        <div class="w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <span class="text-sm font-medium">Carregando catálogo e ofertas selecionadas...</span>
      </div>
    </div>

  </main>

  <footer class="bg-slate-950 border-t border-slate-900 mt-16 text-slate-400 text-sm">
    <div class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Sobre o CompraJogos</h3>
        <p class="text-xs leading-relaxed text-slate-400">O CompraJogos é o seu portal definitivo para curadoria de keys de PC, consoles e notebooks de alta performance.</p>
        <button onclick="abrirModalInstitucional('sobre')" class="text-emerald-400 hover:text-emerald-300 text-xs font-semibold text-left transition w-max cursor-pointer">Ler mais &rarr;</button>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Políticas e Termos</h3>
        <ul class="flex flex-col gap-2 text-xs">
          <li><button onclick="abrirModalInstitucional('privacidade')" class="hover:text-white transition text-left cursor-pointer">Política de Privacidade</button></li>
          <li><button onclick="abrirModalInstitucional('termos')" class="hover:text-white transition text-left cursor-pointer">Termos de Uso</button></li>
        </ul>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="text-white font-bold text-base">Contato & Afiliados</h3>
        <p class="text-xs">Suporte: <a href="mailto:contato@comprajogos.com.br" class="text-emerald-400 hover:underline">contato@comprajogos.com.br</a></p>
      </div>
    </div>
  </footer>

  <!-- Modal -->
  <div id="modal-container" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 relative shadow-2xl flex flex-col gap-4 text-slate-300">
      <button onclick="fecharModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-slate-800 p-1.5 rounded-full transition z-10 cursor-pointer">✕</button>
      <div id="modal-content" class="text-sm leading-relaxed flex flex-col gap-3 max-h-[75vh] overflow-y-auto pr-2"></div>
    </div>
  </div>

  <script define:vars={{ jogosLocais, notebooksLocais }}>
    let catalogoGlobal = [];
    let filtroAtual = 'all';
    let generoAtual = 'Todos os Gêneros';

    function parsePrice(priceStr) {
        if (!priceStr) return 0;
        let clean = priceStr.replace('R$', '').replace(/\./g, '').replace(',', '.').trim();
        return parseFloat(clean) || 0;
    }

    async function carregarTudo() {
      const container = document.getElementById('catalog');

      let freeFormatted = [];
      try {
        const resFree = await fetch('https://www.freetogame.com/api/games?sort-by=popularity');
        const freeData = await resFree.json();
        if (Array.isArray(freeData)) {
          freeFormatted = freeData.slice(0, 100).map(item => ({
            id: `free-${item.id}`,
            title: item.title,
            type: 'free',
            genre: item.genre || 'Free-to-Play',
            image: item.thumbnail,
            saleFormatted: 'Gratuito',
            normalFormatted: '',
            savings: 100,
            url: item.game_url,
            platform: 'PC'
          }));
        }
      } catch (e) {}

      const meusJogos = jogosLocais.map((jogo, index) => {
        const nomeLower = (jogo.nome || '').toLowerCase();
        const generoLower = (jogo.genre || '').toLowerCase();
        
        let plat = 'PC';
        if (nomeLower.includes('ps5') || generoLower.includes('ps5')) plat = 'PS5';
        else if (nomeLower.includes('ps4') || generoLower.includes('ps4')) plat = 'PS4';
        else if (nomeLower.includes('xbox') || generoLower.includes('xbox')) plat = 'Xbox';
        else if (nomeLower.includes('nintendo') || generoLower.includes('nintendo') || nomeLower.includes('switch')) plat = 'Nintendo';

        return {
          id: `custom-${index}`,
          title: jogo.nome,
          type: 'paid',
          genre: jogo.genre || 'Destaque',
          image: jogo.image,
          saleFormatted: jogo.preco,
          normalFormatted: jogo.precoNormal,
          savings: jogo.desconto || 0,
          url: jogo.linkBase,
          platform: plat
        };
      });

      const meusNotebooks = notebooksLocais.map((nb, index) => ({
        id: `notebook-${index}`,
        title: nb.nome,
        type: 'notebook',
        genre: nb.genre || 'Notebook',
        image: nb.image,
        saleFormatted: nb.preco,
        normalFormatted: nb.precoNormal,
        savings: nb.desconto || 0,
        url: nb.linkBase,
        descricao: nb.descricao || '',
        platform: 'Hardware'
      }));

      catalogoGlobal = [...meusJogos, ...meusNotebooks, ...freeFormatted];
      
      if (catalogoGlobal.length === 0) {
        container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-8 rounded-xl text-center text-slate-400">Nenhum item cadastrado ou disponível no momento.</div>`;
        return;
      }

      construirBarraGeneros();
      filtrarJogos();
    }

    function construirBarraGeneros() {
      const bar = document.getElementById('genre-bar');
      if (!bar) return;
      bar.innerHTML = '';
      const generosUnicos = ['Todos os Gêneros', ...new Set(catalogoGlobal.map(j => j.genre))].sort();
      generosUnicos.forEach(g => {
        const btn = document.createElement('button');
        btn.className = `px-3.5 py-1.5 rounded-full text-xs font-semibold transition whitespace-nowrap border cursor-pointer ${generoAtual === g ? 'bg-emerald-500 text-slate-950 border-emerald-500 font-bold shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-400 border-slate-800 hover:bg-slate-800 hover:text-white'}`;
        btn.innerText = g;
        btn.onclick = () => mudarGenero(g);
        bar.appendChild(btn);
      });
    }

    window.mudarFiltro = function(filtro, el) {
      filtroAtual = filtro;
      generoAtual = 'Todos os Gêneros';
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      el.classList.remove('bg-slate-800', 'text-slate-300');
      el.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold');
      construirBarraGeneros();
      filtrarJogos();
    }

    function mudarGenero(genero) {
      generoAtual = genero;
      construirBarraGeneros();
      filtrarJogos();
    }

    window.filtrarJogos = function() {
      const container = document.getElementById('catalog');
      if (!container) return;

      const minVal = parseFloat(document.getElementById('minPrice').value) || 0;
      const maxVal = parseFloat(document.getElementById('maxPrice').value) || Infinity;

      const filtrados = catalogoGlobal.filter(j => {
        let matchFiltro = true;
        if (filtroAtual === 'promocoes') {
          matchFiltro = (j.type === 'paid' || j.type === 'notebook') && j.savings > 0;
        } else if (filtroAtual === 'gratuitos') {
          matchFiltro = j.type === 'free';
        } else if (filtroAtual === 'notebooks') {
          matchFiltro = j.type === 'notebook';
        } else if (filtroAtual === 'pc') {
          matchFiltro = j.platform === 'PC';
        } else if (filtroAtual === 'ps4') {
          matchFiltro = j.platform === 'PS4';
        } else if (filtroAtual === 'ps5') {
          matchFiltro = j.platform === 'PS5';
        } else if (filtroAtual === 'xbox') {
          matchFiltro = j.platform === 'Xbox';
        } else if (filtroAtual === 'nintendo') {
          matchFiltro = j.platform === 'Nintendo';
        }

        const matchGenero = generoAtual === 'Todos os Gêneros' || j.genre === generoAtual;
        const precoNumerico = parsePrice(j.saleFormatted);
        const matchPreco = precoNumerico >= minVal && precoNumerico <= maxVal;

        return matchFiltro && matchGenero && matchPreco;
      });

      if (filtrados.length === 0) {
        container.innerHTML = `<div class="col-span-full bg-slate-900 border border-slate-800 p-12 rounded-2xl text-center text-slate-400">Nenhum item encontrado com esses filtros.</div>`;
        return;
      }

      container.innerHTML = filtrados.map(item => `
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-slate-700 transition-all duration-300 shadow-xl">
          <div class="relative bg-slate-950 h-44 overflow-hidden flex items-center justify-center">
            <img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=600&auto=format&fit=crop'" />
            <span class="absolute top-3 left-3 bg-slate-900/90 text-slate-300 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider">${item.genre}</span>
            ${item.savings > 0 && (item.type === 'paid' || item.type === 'notebook') ? `<span class="absolute top-3 right-3 bg-emerald-500 text-slate-950 font-black text-xs px-2 py-1 rounded-md shadow">-${item.savings}%</span>` : ''}
            ${item.type === 'free' ? `<span class="absolute top-3 right-3 bg-indigo-600 text-white font-bold text-xs px-2 py-1 rounded-md shadow">Grátis</span>` : ''}
          </div>
          <div class="p-5 flex flex-col flex-1 justify-between gap-4">
            <h4 class="font-bold text-white text-sm line-clamp-2 leading-snug">${item.title}</h4>
            <div class="flex justify-between items-end border-t border-slate-800 pt-4">
              <div>
                ${item.type === 'paid' || item.type === 'notebook' ? `
                  ${item.normalFormatted ? `<span class="text-xs text-slate-500 line-through block">${item.normalFormatted}</span>` : ''}
                  <span class="text-lg font-black text-emerald-400">${item.saleFormatted}</span>
                ` : `
                  <span class="text-xs text-slate-500 block">Plataforma PC</span>
                  <span class="text-sm font-extrabold text-indigo-400">Free-to-Play</span>
                `}
            </div>
            <button onclick="abrirModalJogo('${item.id}')" class="font-bold py-2.5 px-4 rounded-xl text-xs transition shadow-lg cursor-pointer ${item.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'}">
              ${item.type === 'free' ? 'Jogar Grátis' : item.type === 'notebook' ? 'Ver Notebook' : 'Ver Oferta'}
            </button>
          </div>
        </div>
      </div>
      `).join('');
    }

    window.abrirModalJogo = function(id) {
      const jogo = catalogoGlobal.find(j => j.id === id);
      if (!jogo) return;

      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      
      content.innerHTML = `
        <div class="flex flex-col gap-4">
          <div class="w-full h-48 rounded-xl overflow-hidden bg-slate-950 border border-slate-800">
            <img src="${jogo.image}" alt="${jogo.title}" class="w-full h-full object-cover" />
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">${jogo.genre}</span>
            <h3 class="text-xl font-bold text-white mt-1">${jogo.title}</h3>
          </div>
          <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block">${jogo.type === 'free' ? 'Tipo de Acesso' : 'Preço na Loja'}</span>
              <span class="text-xl font-black ${jogo.type === 'free' ? 'text-indigo-400' : 'text-emerald-400'} mt-1 block">${jogo.saleFormatted}</span>
            </div>
            ${jogo.savings > 0 && (jogo.type === 'paid' || jogo.type === 'notebook') ? `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-3 py-1 rounded-lg text-xs font-bold">-${jogo.savings}% OFF</span>` : ''}
          </div>
          ${jogo.descricao ? `
            <div class="bg-slate-950/40 p-3.5 rounded-xl border border-slate-800 text-xs text-slate-300 leading-relaxed">
              <span class="font-bold text-white block mb-1">Especificações Técnicas:</span>
              ${jogo.descricao}
            </div>
          ` : ''}
          <a href="${jogo.url}" target="_blank" rel="noopener noreferrer" onclick="fecharModal()" class="w-full ${jogo.type === 'free' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950'} font-bold py-3.5 px-4 rounded-xl text-xs text-center transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
            ${jogo.type === 'free' ? 'Acessar Jogo Grátis' : jogo.type === 'notebook' ? 'Ver Notebook na Loja' : 'Ir para a Loja Oficial'} &rarr;
          </a>
        </div>
      `;
      modal.classList.remove('hidden');
    }

    const textosModais = {
      sobre: `<h3 class="text-lg font-bold text-white">Sobre o CompraJogos</h3><p>Portal especializado em curadoria de ofertas de chaves de PC, consoles e notebooks de alto desempenho.</p>`,
      privacidade: `<h3 class="text-lg font-bold text-white">Política de Privacidade</h3><p>Seus dados estão seguros. Utilizamos cookies para melhor experiência.</p>`,
      termos: `<h3 class="text-lg font-bold text-white">Termos de Uso</h3><p>Ao utilizar nosso site, você concorda com nossos termos de parceria e afiliados.</p>`
    };

    window.abrirModalInstitucional = function(tipo) {
      const modal = document.getElementById('modal-container');
      const content = document.getElementById('modal-content');
      if (textosModais[tipo]) {
        content.innerHTML = textosModais[tipo];
        modal.classList.remove('hidden');
      }
    }

    window.fecharModal = function() {
      document.getElementById('modal-container').classList.add('hidden');
    }

    carregarTudo();
  </script>
</LayoutPrincipal>
        const nomeLower = (jogo.nome || '').toLowerCase();
        const generoLower = (jogo.genre || '').toLowerCase();
        
        let plat = 'PC';
        if (nomeLower.includes('ps5') || generoLower.includes('ps5')) plat = 'PS5';
        else if (nomeLower.includes('ps4') || generoLower.includes('ps4')) plat = 'PS4';

---
import '../styles/global.css';
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import jogosLocais from '../data/jogos.json'; 
import notebooksLocais from '../data/notebooks.json';
import ProductSchema from '../components/ProductSchema.astro';
---

<LayoutPrincipal titulo="CompraJogos - Notebooks, PC (Grátis e Pagos), PS4, PS5, Xbox e Nintendo" descricao="Explore centenas de jogos de PC grátis e pagos, ofertas para PS4, PS5, Xbox, Nintendo, além de notebooks de alta performance.">
  <head slot="head">
    {jogosLocais.map((jogo) => (
      <ProductSchema 
        nome={jogo.nome}
        preco={jogo.preco}
        sku={jogo.nome}
        url={jogo.linkBase}
        imagem={jogo.image}
      />
    ))}
    {notebooksLocais.map((nb) => (
      <ProductSchema 
        nome={nb.nome}
        preco={nb.preco}
        sku={nb.nome}
        url={nb.linkBase}
        imagem={nb.image}
      />
    ))}
  </head>

  <main class="container mx-auto px-4 py-8">

    <!-- Seção de Destaque com o Botão Buraco Negro -->
    <div class="flex flex-col md:flex-row items-center justify-between bg-slate-900/60 border border-slate-800 p-6 rounded-2xl mb-8 gap-4 shadow-xl backdrop-blur-md">
      <div>
        <h2 class="text-lg font-bold text-white">Procurando algo específico?</h2>
        <p class="text-xs text-slate-400">Clique para ser levado instantaneamente a uma oferta aleatória incrível do nosso catálogo.</p>
      </div>
      
      <!-- O Botão Buraco Negro -->
      <div class="black-hole-btn" onclick="abrirOfertaAleatoria()">
        <div class="event-horizon">
          <span class="bh-icon">🔥</span>
          <span class="bh-text">Surpreenda-me</span>
        </div>
      </div>
    </div>
    
    <!-- Carrossel Exclusivo com os Jogos de Lançamento -->
    <div class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-black text-lg flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Lançamentos
        </h3>
        <div class="flex gap-2">
          <button onclick="rolarCarrossel(-1)" class="bg-slate-900 border border-slate-800 hover:bg-slate-800 text-white p-2 rounded-xl transition cursor-pointer shadow">
            &larr;
          </button>
          <button onclick="rolarCarrossel(1)" class="bg-slate-900 border border-slate-800 hover:bg-slate-800 text-white p-2 rounded-xl transition cursor-pointer shadow">
            &rarr;
          </button>
        </div>
      </div>
      
      <div id="carousel-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 scroll-smooth">
        <div class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl text-center text-slate-400 min-w-[280px] flex items-center justify-center">
          Carregando lançamentos...
        </div>
      </div>
    </div>

    <!-- Filtros e Barra de Gêneros -->
    <div class="bg-slate-900/85 backdrop-blur-md p-5 rounded-2xl border border-slate-800 shadow-xl mb-8 flex flex-col gap-4">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filtrar por:</span>
        <button onclick="mudarFiltro('all', this)" class="filter-btn active bg-emerald-500 text-slate-950 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Todos</button>
        <button onclick="mudarFiltro('promocoes', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Promoções</button>
        <button onclick="mudarFiltro('gratuitos', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Jogos Gratuitos</button>
        <button onclick="mudarFiltro('notebooks', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Notebooks</button>
        <button onclick="mudarFiltro('pc', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">PC</button>
        <button onclick="mudarFiltro('ps5', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">PS5</button>
        <button onclick="mudarFiltro('xbox', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Xbox</button>
        <button onclick="mudarFiltro('nintendo', this)" class="filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-full text-xs font-bold transition cursor-pointer">Nintendo</button>
      </div>

      <!-- Filtro de Preço -->
      <div class="flex items-center gap-3 flex-wrap pt-4 border-t border-slate-800">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Faixa de Preço (R$):</span>
        <input type="number" id="minPrice" placeholder="Mín" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white w-24 focus:outline-none focus:border-emerald-500">
        <input type="number" id="maxPrice" placeholder="Máx" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-white w-24 focus:outline-none focus:border-emerald-500">
        <button onclick="filtrarJogos()" class="bg-slate-800 hover:bg-emerald-600 text-white px-4 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer">Aplicar Preço</button>
      </div>

      <div id="genre-bar" class="flex gap-2 overflow-x-auto pb-2 scrollbar-thin"></div>
    </div>

    <!-- Anúncio Google AdSense (Lazy Loaded / Carregado apenas após a rolagem no mobile para otimizar Speed Index e aprovação) -->
    <div id="ad-container" class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-4 mb-8 text-center overflow-hidden flex flex-col items-center justify-center min-h-[120px]">
      <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-2 font-semibold">Anúncio Publicitário</span>
      <div id="ad-slot-wrapper" class="w-full min-h-[90px] flex items-center justify-center">
        <!-- Injetado dinamicamente via JS após a primeira rolagem -->
      </div>
    </div>

    <!-- Grade de Produtos -->
    <div id="catalog" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <div class="col-span-full bg-slate-900/50 border border-slate-800 p-12 rounded-2xl text-center text-slate-400 flex flex-col items-center justify-center gap-4">
        <div class="w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <span class="text-sm font-medium">Carregando catálogo e principais ofertas...</span>
      </div>
    </div>

    <!-- Bloco de SEO -->
    <section class="seo-content mt-16 py-8 px-6 bg-slate-900/40 border border-slate-800/80 rounded-2xl text-slate-300">
      <h2 class="text-xl font-bold text-white mb-4">Onde comprar jogos mais baratos para Steam, PS5, Xbox e Nintendo Switch?</h2>
      <p class="mb-4 text-xs sm:text-sm leading-relaxed">
        Se você está procurando onde encontrar <strong>jogos baratos para Steam</strong>, chaves de ativação seguras (keys) ou promoções imperdíveis para PlayStation 5, Xbox Series X|S e Nintendo Switch, o <strong>CompraJogos</strong> é o seu agregador definitivo. Monitoramos diariamente os melhores descontos do mercado gamer para garantir que você economize em lançamentos e clássicos.
      </p>
      <p class="text-xs sm:text-sm leading-relaxed">
        Além de keys e games digitais para PC, nossa curadoria também destaca notebooks gamers de alta performance, jogos gratuitos (Free-to-Play) e pacotes de expansão. Aproveite comparativos de preços transparentes e links diretos para as lojas oficiais mais confiáveis da internet.
      </p>
    </section>

  </main>

  <!-- Botão Flutuante do WhatsApp -->
